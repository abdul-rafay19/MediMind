# ═══════════════════════════════════════════════════════════════
# MediMind — Environment Configuration
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it's already in .gitignore.
# ═══════════════════════════════════════════════════════════════

# ── Security ────────────────────────────────────────────────────
# Generate a random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=e1bf0af12ad4eb6af6f6da07613d406953f8906f9f2897836c589a15724fb67a

# ── Database (auth/users only — everything else lives in Firestore) ──
DATABASE_URL=sqlite+aiosqlite:///./medimind.db
DEBUG=false

# ── CORS: add your deployed frontend URL here once you have one ──
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:5500","https://your-frontend.vercel.app"]

# ── Firebase ──────────────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Local dev: save the file as backend/serviceAccountKey.json and use the path below.
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
# Cloud deploy (Render/Railway): instead, paste the ENTIRE JSON file contents
# as one line into this variable via your host's dashboard, and leave the
# path above as-is (JSON takes priority when both are set).
FIREBASE_CREDENTIALS_JSON=

# ── NVIDIA NIM (free-tier LLM, OpenAI-compatible API) ──────────
# Get a free key at https://build.nvidia.com (click any model → "Get API Key")
OPENROUTER_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=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

LLM_PRIMARY_MODEL=meta/llama-3.1-8b-instruct
LLM_SECONDARY_MODEL=mistralai/mistral-7b-instruct-v0.3
LLM_FALLBACK_MODEL=microsoft/phi-3-mini-4k-instruct
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.1

# ── RAG ─────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
KNOWLEDGE_BASE_DIR=./data/knowledge_base
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
